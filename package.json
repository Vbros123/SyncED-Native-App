{
  "name": "synced-native-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && open -a Xcode ios/App/App.xcodeproj",
    "native:android:apk": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "native:doctor": "cap doctor",
    "qa": "npm run qa:i18n && node scripts/qa.mjs",
    "qa:i18n": "node scripts/i18n-data-audit.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run build && npm run test && npm run qa"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@vitejs/plugin-react": "*",
    "lucide-react": "*",
    "qrcode": "^1.5.4",
    "react": "*",
    "react-dom": "latest",
    "typescript": "*",
    "vite": "*",
    "@mlc-ai/web-llm": "^0.2.84"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^149.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1",
    "vitest": "^4.1.11"
  },
  "description": "Offline-first multilingual education app for web, iOS, and Android.",
  "engines": {
    "node": ">=22.17.0"
  }
}
